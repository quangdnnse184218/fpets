# Supabase configuration (fill in your actual values in .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret dùng để xác thực các route /api/cron/* (Vercel Cron tự gửi header
# "Authorization: Bearer <CRON_SECRET>" khi biến này được set trên Vercel).
CRON_SECRET=
